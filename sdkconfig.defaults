# Target and flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# CPU and FreeRTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# 8 MB octal PSRAM (N16R8). Camera frames and wasm copies live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# Console
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# LVGL 8.4
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_CANVAS=y

# XPT2046 reports raw 12-bit values; board_touch.c maps them to screen pixels.
# CONFIG_XPT2046_CONVERT_ADC_TO_COORDS is not set

# Feature toggles
CONFIG_DALANGS_CAMERA_ENABLE=y
CONFIG_DALANGS_LCD_SPI_MODE_0=y

CONFIG_LV_DISP_ROT_MAX_BUF=10240
CONFIG_LV_MEM_SIZE_KILOBYTES=32

# Touch: lower pressure threshold for finger input
CONFIG_XPT2046_Z_THRESHOLD=40
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_LV_COLOR_CHROMA_KEY_HEX=0xFF00FF
CONFIG_LV_FONT_MONTSERRAT_16=y

# LVGL ships ~600 example sources; nothing here uses them and they dominate build time.
CONFIG_LV_BUILD_EXAMPLES=n
